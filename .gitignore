# Ignore build directories #
############################
Debug/
Release/
build*/
cmake-build*/
out/
test*/
# Local host regressions and experimental documentation are not firmware sources.
/tests/
/docs/

# Compiled source #
###################
*.com
*.class
*.dll
*.d
*.map
*.o
*.so

# Packages #
############
# it's better to unpack these files and commit the raw source
# git has its own built in compression methods
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip
*.md

# Logs and databases #
######################
*.log
*.sql
*.sqlite

# OS generated files #
######################
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.nds
*.elf
*.a
.vscode/
roms/*.nds
data/uartBufv060.bin

; APS6404L PSRAM transaction engine (RP2354A board wiring).
;
; Pin roles (design section 2.5.1 / 4.1):
;   OUT/IN/SET base : GPIO22..25  (SIO0..SIO3, four shared data lines)
;   side-set        : GPIO0       (SCLK, driven only by this SM)
;   CE0..CE3        : GPIO26..29  (CPU/SIO owned, held high when idle)
;
; The engine speaks the 1-4-4 profile from design section 2.6: an 8-bit
; serial (SPI) command on SIO0, a 24-bit quad address (6 clocks), then either
; 6 dummy clocks followed by quad read data, or immediate quad write data.
; The command and 24-bit address are presented as a single 32-bit word
; ((cmd << 24) | addr). While the command is shifted out one bit at a time
; only SIO0 is driven, so SIO1..3 keep the high level the CPU preloaded.
;
; The side-set is mandatory (not "opt"), so every instruction explicitly
; defines the SCLK level and no instruction can leave it floating. CPOL=0,
; CPHA=0: data is driven while SCLK is low and sampled on the rising edge.
;
; Data-phase geometry: 2 SM cycles per nibble in both directions, so every
; PSRAM phase (command, address, dummy, read data, write data) runs at
; sysclk / (2 * div) with the same absolute margins:
;   read : SCLK rises at the end of "nop side 1"; the input synchronizer is
;          bypassed (psramEngineInit), so "in pins, 4" samples at the end of
;          the next cycle - exactly one SM cycle after the rising edge and
;          one SM cycle before the next one. At div=1.5 on a 150 MHz sysclk
;          that is the same 10 ns settling/hold the 200 MHz div=2
;          qualification run proved for the address phase.
;   write: the nibble is driven at the end of "out pins, 4"; the rising edge
;          lands one SM cycle later on "jmp x-- side 1" - one SM cycle of
;          setup and one SM cycle of hold, identical to the address phase.
; The previous 3-cycle data loops bought settling by lengthening the bit
; period; the 2-cycle loops keep the proven absolute nanosecond margins and
; raise the data SCLK from sysclk/(6*div) to sysclk/(2*div).
;
; Read completion and write back-pressure are CPU/DMA events, not PIO IRQs:
; the read loop clocks until the CPU stops the SM (the two-instruction loop
; wraps via .wrap_target/.wrap), and the write loop blocks on PULL when the
; DMA has no more words. This keeps the program small and avoids an extra
; IRQ path on the timing-critical cartridge core.
;
; Autopull is disabled: a blocking PULL explicitly loads the command/address
; word and each write word, so the read program can leave the OSR empty after
; the address without stalling. Autopush is enabled on the RX side.
;
; The write program is placed first so its entry address can never coincide
; with the read loop's wrap address (a jump landing exactly on the wrap
; address would be redirected to wrap_target).
.program psram_quad
.side_set 1

; --------------------------------------------------------------------------
; Entry: psram_quad_write
;   TX: word0 = (0x38 << 24) | addr, then one word per 4 data bytes
; --------------------------------------------------------------------------
public psram_quad_write:
    pull                    side 0
    set x, 7                side 0
wr_serial:
    out pins, 1             side 0
    jmp x-- wr_serial       side 1
    set y, 5                side 0
wr_addr:
    out pins, 4             side 0
    jmp y-- wr_addr         side 1
wr_data:
public psram_quad_write_idle:
    pull                    side 0  ; block until the next data word arrives
    set x, 7                side 0
wr_nib:
    out pins, 4             side 0  ; nibble driven while SCLK low
    jmp x-- wr_nib          side 1  ; rising edge one cycle later (setup)
    jmp wr_data             side 0  ; word done: SCLK low, fetch next word

; --------------------------------------------------------------------------
; Entry: psram_quad_read
;   TX: one word = (0xEB << 24) | addr
;   RX: 4-bit data nibbles, autopushed 8 nibbles (32 bits) per word
; --------------------------------------------------------------------------
public psram_quad_read:
    pull                    side 0  ; command + address word
    set x, 7                side 0
rd_serial:
    out pins, 1             side 0  ; drive SIO0 while SCLK low
    jmp x-- rd_serial       side 1  ; rising edge: PSRAM samples
    set y, 5                side 0
rd_addr:
    out pins, 4             side 0  ; 4-bit address nibble while SCLK low
    jmp y-- rd_addr         side 1  ; rising edge: PSRAM samples
    set pindirs, 0          side 0  ; release SIO0..3 for the read data phase
    set x, 5                side 0
rd_dummy:
    nop                     side 1
    jmp x-- rd_dummy        side 0  ; six dummy clocks, ending SCLK low
.wrap_target
rd_data:
    nop                     side 1  ; rising edge at the end of this cycle
    in pins, 4              side 0  ; sample one cycle later; SCLK low after
.wrap
